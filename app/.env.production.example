# ── Gold Miner — MAINNET Production Environment ───────────────────────────────
# Copy to app/.env.production (or set as env vars in Vercel project + .env.local
# locally). Inlined at build time — set BEFORE `next build`; changing requires a rebuild.
#
# ⚠️ These are PUBLIC network/deploy addresses only — NO private keys / keypairs here.
#
# GREENFIELD: mainnet is a FRESH deployment (fresh program keypair + fresh GOLD mint +
# fresh AMM pool) per MAINNET_LAUNCH_PLAN.md §1.1–1.3. Nothing below is copied from
# testnet. Values marked "→ SEE" are generated by the listed deploy step.

# ── Network RPC / WebSocket ─────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.x1.xyz
# ⚠️ CONFIRM mainnet WS endpoint exists (repo confirms RPC; WS assumed same host).
NEXT_PUBLIC_WS_URL=wss://ws.mainnet.x1.xyz

# ── Game program + token (fresh mainnet deploy) ─────────────────────────────
# → SEE MAINNET_LAUNCH_PLAN §1.2 (generate NEW program keypair) + §2.1 deploy.
# Do NOT reuse the testnet program ID (4GQU2... / GLDFu...).
NEXT_PUBLIC_PROGRAM_ID=<MAINNET_PROGRAM_ID_FROM_NEW_KEYPAIR>
# → SEE §1.1 / §2.2: fresh Token-2022 GOLD mint w/ MetadataExtension enabled at creation.
# Metadata: name=Goldium symbol=GOLD decimals=9, Arweave image cxmHUDnAAt9jUV4RDiEFM5jkoUCR8awzIcnSpcD1r5o
NEXT_PUBLIC_GOLD_MINT=<MAINNET_GOLD_MINT>
# → SEE §2.4 init_game (on-chain bitmap PDA created at init).
NEXT_PUBLIC_GOLD_BITMAP=<MAINNET_GOLD_BITMAP_PDA>

# ── AMM (treasury_auto_lp) — mainnet ≠ testnet ───────────────────────────────
# AMM_PROGRAM_ID is CONFIRMED (launch plan §1.3): mainnet uses sEsYH... (testnet 7EEuq...).
# The remaining AMM addresses (market authority, config, pool, vaults, observer, LP mint)
# are all produced by creating the mainnet GOLD/XNT pool → fill from that step.
NEXT_PUBLIC_AMM_PROGRAM_ID=sEsYH97wqmfnkzHedjNcw3zyJdPvUmsa9AixhS4b4fN
NEXT_PUBLIC_AMM_MARKET_AUTHORITY=<MAINNET_AMM_MARKET_AUTHORITY_FROM_POOL>
NEXT_PUBLIC_AMM_CONFIG=<MAINNET_AMM_CONFIG_FROM_POOL>
NEXT_PUBLIC_AMM_POOL_STATE=<MAINNET_AMM_POOL_STATE_FROM_POOL>
NEXT_PUBLIC_AMM_GOLD_VAULT=<MAINNET_AMM_GOLD_VAULT_FROM_POOL>
NEXT_PUBLIC_AMM_XNT_VAULT=<MAINNET_AMM_XNT_VAULT_FROM_POOL>
NEXT_PUBLIC_AMM_OBSERVER_STATE=<MAINNET_AMM_OBSERVER_STATE_FROM_POOL>
# Must match NEXT_PUBLIC_GOLD_MINT above (the mainnet GOLD mint) — NOT the testnet vKxn...
NEXT_PUBLIC_AMM_GOLD_MINT=<SAME_AS_NEXT_PUBLIC_GOLD_MINT>
NEXT_PUBLIC_AMM_LP_MINT=<MAINNET_AMM_LP_MINT_FROM_POOL>
#
# NOT env-driven (network-stable; hardcoded in constants.ts — do NOT set):
#   AMM_XNT_MINT / AMM_XNT_TOKEN_PROG / AMM_GOLD_TOKEN_PROG / AMM_LP_TOKEN_PROG / INCINERATOR

# ── Fill order (so you never set an orphan value) ─────────────────────────────
# 1. Program ID  ← from the NEW mainnet program keypair (MAINNET_LAUNCH_PLAN §1.2)
# 2. GOLD_MINT   ← from fresh Token-2022 mint w/ metadata (§1.1 / §2.2)
# 3. GOLD_BITMAP ← from init_game (§2.4)
# 4. AMM_PROGRAM_ID  ← CONFIRMED (sEsYH...); remaining AMM addrs ← pool creation (§1.3 / §2.3)
# 5. Wire PROGRAM_ID + GOLD_MINT + GOLD_BITMAP into GameConfig on-chain, THEN publish this file.
