# ── Gold Miner — Environment Variables ────────────────────────────────────────
# Copy this file to `app/.env.local` (testnet) or `app/.env.production` (mainnet)
# and fill in the values. All keys are prefixed NEXT_PUBLIC_ (server-safe, inlined
# at build time — MUST be set before `next build`, changing them requires a rebuild).
#
# TESTNET DEFAULTS are shown below = current live X1 testnet deployment.
# For MAINNET, override the network-specific keys with the mainnet values
# (fresh GOLD mint + fresh program keypair + mainnet AMM — see MAINNET_LAUNCH_PLAN.md).
#
# ⚠️ These are public/network addresses only — NO private keys go here.

# ── Network RPC / WebSocket ──────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.x1.xyz
NEXT_PUBLIC_WS_URL=wss://ws.testnet.x1.xyz

# ── Game program + token (network-specific) ─────────────────────────────────
# Main game program ID (frontend default: 4GQU2... = live testnet v5).
NEXT_PUBLIC_PROGRAM_ID=4GQU2H48Ai2WtM8mzGexLGDA1KAcrvrHRXG1WeHaWxAM
# GOLD mint (Token-2022, 9 decimals). Live testnet mint.
NEXT_PUBLIC_GOLD_MINT=vKxnbuf4HeR6espPnfnVwaByaWgp3NHSGWGmjyNyrS6
# Gold-spot bitmap account (on-chain worldgen bitmap).
NEXT_PUBLIC_GOLD_BITMAP=HaphYcxXYfPbUCppeYkDNpVTZhdGcwbPQonwx7kTjzK5

# ── AMM (treasury_auto_lp) — network-specific ────────────────────────────────
# These were made env-driven on 2026-09-18 so a mainnet build can't silently
# point at testnet pools. Testnet defaults below.
#
# ⚠️ MAINNET DIFFERS: mainnet AMM program = sEsYH... (testnet = 7EEuq...).
#    Supply the full mainnet AMM set at mainnet deploy (MAINNET_LAUNCH_PLAN §1.3).
NEXT_PUBLIC_AMM_PROGRAM_ID=7EEuq61z9VKdkUzj7G36xGd7ncyz8KBtUwAWVjypYQHf
NEXT_PUBLIC_AMM_MARKET_AUTHORITY=2HbqjtA9gB9c95c8KkUUWxhtNjCfYcPbvfdhcdobbq1C
NEXT_PUBLIC_AMM_CONFIG=3FzzbxwpdJKxRW1yNT7UPYmna17SwC9PRmskMa8A2BuY
NEXT_PUBLIC_AMM_POOL_STATE=FuWCSt8fx3r8CZ7UjsbxxozNxJipgcT3XUcsSVVTzWtz
NEXT_PUBLIC_AMM_GOLD_VAULT=DvprQjnFnjhdjqLDkagcjSsqYZNuDPbXmto9zdqDcE94
NEXT_PUBLIC_AMM_XNT_VAULT=AkvjBU6S3G4UdrXFHrgZPxnofrCgEToXvtbczKpFqvFD
NEXT_PUBLIC_AMM_OBSERVER_STATE=DUd6JfdKGA8M2xiSWLGwfxkDgHXWQKVLL6CCvcdFx2En
NEXT_PUBLIC_AMM_GOLD_MINT=vKxnbuf4HeR6espPnfnVwaByaWgp3NHSGWGmjyNyrS6
NEXT_PUBLIC_AMM_LP_MINT=R42M1rNtsrDvTAKMZbMWHE2TXZxPqAZzZ5bR6uR3Qzy
