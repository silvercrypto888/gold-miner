# NOT env-driven (network-stable / derived, hardcoded in constants.ts):
#   AMM_XNT_MINT      = So11111111111111111111111111111111111111112
#   AMM_XNT_TOKEN_PROG= TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
#   AMM_GOLD_TOKEN_PROG=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
