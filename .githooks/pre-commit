#!/bin/sh
# Pre-commit hook: block sensitive files from being committed.
# Installed by running: git config core.hooksPath .githooks

set -e

RED='\033[0;31m'
NC='\033[0m'

# File patterns (case-insensitive) — match the full filename or path component.
# Each entry is a regex snippet that must match against the full filename.
# Note: "keypair.json" catches both "my-keypair.json" and "subdir/keypair.json".
# BUT we use word boundary anchors so "useSessionKey.ts" does NOT match.
FORBIDDEN_FILE_PATTERNS="
keypair\.json
-id\.json$
wallet\.json$
secret\.json$
\.env$
\.env\.local$
\.env\.production$
\.env\.secret$
private\.key$
private\.pem$
mnemonic\.
seed_phrase
"

# Build the grep pattern
PATTERN=$(echo "$FORBIDDEN_FILE_PATTERNS" | tr '\n' '|' | sed 's/|$//' | sed 's/^|//' | sed 's/||/|/g')

STAGED=$(git diff --cached --name-only)

# File name check
STAGED_VIOLATIONS=$(echo "$STAGED" | grep -iE "$PATTERN" | grep -vE '^\.githooks/pre-commit$|^\.gitignore$' || true)
if [ -n "$STAGED_VIOLATIONS" ]; then
    echo "${RED}❌ COMMIT BLOCKED — sensitive files detected in staged changes:${NC}"
    echo "$STAGED_VIOLATIONS" | sed 's/^/   /'
    echo ""
    echo "${RED}These files look like keys, secrets, or credentials. Remove them from the commit,"
    echo "add them to .gitignore, and use environment variables or hardware wallets instead.${NC}"
    echo ""
    echo "If this is a false positive, skip the hook with: git commit --no-verify"
    exit 1
fi

# Content check for JSON arrays that look like raw keypair bytes
echo "$STAGED" | grep '\.json$' | while read -r f; do
    # Skip .gitignore and the hook itself (they contain pattern words)
    case "$f" in .githooks/*|.gitignore) continue ;; esac
    content=$(git show ":$f" 2>/dev/null || true)
    if echo "$content" | grep -qE '^\[[[:space:]]*(12[0-7]|1[01][0-9]|[1-9]?[0-9])'; then
        count=$(echo "$content" | grep -oE '[0-9]+' | wc -l)
        if [ "$count" -ge 32 ] && [ "$count" -le 128 ]; then
            echo "${RED}❌ COMMIT BLOCKED — $f appears to contain raw keypair bytes${NC}"
            echo "${RED}   Detected a JSON numeric array with $count elements (looks like a private key).${NC}"
            echo "${RED}   Remove this file from the commit and store keys securely.${NC}"
            exit 1
        fi
    fi
done || exit 1

exit 0
